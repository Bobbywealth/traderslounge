# =============================================================================
# Traders Lounge - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit real secrets to git!

# -----------------------------------------------------------------------------
# Database (PostgreSQL recommended for production)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/traderslounge
# Or for SQLite (development only):
# DATABASE_URL=
SIGNAL_DB_PATH=scanner.db

# -----------------------------------------------------------------------------
# Market Data Providers
# -----------------------------------------------------------------------------
# Twelve Data - Forex, Gold, Indices
# Get your key at: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVE_DATA_RPM=8  # Free tier: 8 requests/minute

# Finnhub - Alternative market data
# Get your key at: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# -----------------------------------------------------------------------------
# AI Integration (Optional)
# -----------------------------------------------------------------------------
# MiniMax - For AI-assisted analysis
# Get your key at: https://minimax.chat/
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M3

# Perplexity - Alternative AI
# Get your key at: https://perplexity.ai/
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# -----------------------------------------------------------------------------
# Authentication (Required for production)
# -----------------------------------------------------------------------------
JWT_SECRET=generate_a_32_byte_random_string_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Broker Integration (Optional)
# -----------------------------------------------------------------------------
# TradeLocker
TRADELOCKER_EMAIL=your_tradelocker_email
TRADELOCKER_PASSWORD=your_tradelocker_password
TRADELOCKER_SERVER=demo.tradelocker.com  # or live.tradelocker.com
TRADELOCKER_ACCOUNT_NUM=your_account_number
TRADELOCKER_IS_DEMO=true

# -----------------------------------------------------------------------------
# Execution Mode
# -----------------------------------------------------------------------------
# paper = Paper trading (safe)
# live = Real money (DANGEROUS - requires API keys)
# off = No execution
EXECUTION_MODE=paper
RISK_PER_TRADE_PCT=0.5
PAPER_STARTING_BALANCE_USD=10000

# -----------------------------------------------------------------------------
# Scanner Configuration
# -----------------------------------------------------------------------------
SCAN_INTERVAL_SECONDS=300  # 5 minutes
SCAN_REQUEST_PATH=/tmp/bwts.scan_request
NEWS_BLACKOUT_MINUTES=15

# Signal thresholds
STRONG_THRESHOLD=65
GOOD_THRESHOLD=50
WATCHLIST_THRESHOLD=35

# -----------------------------------------------------------------------------
# Alert Delivery (Optional)
# -----------------------------------------------------------------------------
# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=alerts@traderslounge.com

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# SENTRY_DSN=https://example@sentry.io/project

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=https://traderslounge.onrender.com
