# ConfluenceX — environment variables
# Copy to .env and fill in real values. Never commit real keys.

# --- Frontend (Vite) ---
VITE_BWTS_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:3001

# --- Data sources ---
FINNHUB_API_KEY=your_finnhub_key
PERPLEXITY_API_KEY=your_perplexity_key

# --- Notifications / messaging ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- Backend (server/) ---
NODE_ENV=development
PORT=3001

# Postgres connection string (Neon recommended; local Postgres also works).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret used by the Python BWTS API (scanner/auth.py). The Express
# billing routes verify tokens with this same secret. Must be identical.
JWT_SECRET=change-me-to-a-long-random-string

# Set to 1 to have the Express server apply db/migrations/*.sql on boot.
BILLING_RUN_MIGRATIONS=0

# Public-facing URL used for Stripe Checkout success/cancel redirects and
# Billing Portal return URLs. Falls back to the request Origin header.
APP_BASE_URL=http://localhost:5173

# Allowed CORS origins (comma-separated). Use for production deployments.
CORS_ALLOWED_ORIGINS=https://traderslounge.onrender.com

# --- Stripe (test mode keys during development) ---
# Server-only. NEVER prefix with VITE_.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe price IDs (created in the Stripe dashboard or via the Stripe CLI).
STRIPE_PRICE_PRO_MONTHLY=price_replace_me_monthly
STRIPE_PRICE_PRO_ANNUAL=price_replace_me_annual
STRIPE_PRICE_FOUNDING_MONTHLY=price_replace_me_founding
